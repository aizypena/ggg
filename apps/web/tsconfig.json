{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // contract-client is generated Soroban TS bindings — a self-contained package
  // with its own tsconfig/build and deps; the web app must not typecheck its source.
  "exclude": ["node_modules", "src/contract-client"]
}
